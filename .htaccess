DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# Redirect only explicit requests, not Apache's internal DirectoryIndex lookup.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://mobileland.kz/ [R=301,L]
RewriteRule ^services\.html$ https://mobileland.kz/#services [R=301,L,NE]
RewriteRule ^(?:about|location)\.html$ https://mobileland.kz/#contacts [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.mobileland\.kz$ [NC]
RewriteRule ^ https://mobileland.kz%{REQUEST_URI} [R=301,L]
</IfModule>

# Response headers are configured in Plesk: Apache and nginx > Additional headers.
